{
  "manifest_version": 3,
  "name": "Claude Profiles",
  "version": "0.4.0",
  "description": "Keep every Claude account in one Chromium and let agents switch and open claude.ai sessions.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "storage",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Profiles",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://claude.ai/*",
      "https://*.claude.ai/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
